{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Update Library Symbols",
			"type": "shell",
			"command": "npx ts-node scripts/parseSkeletons.ts",
			"options": {
				"cwd": "${workspaceFolder}/src"
			},
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "Compile",
			"type": "npm",
			"script": "compile",
			"path": "src",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$tsc"
		},
		{
			"label": "Watch",
			"type": "npm",
			"script": "watch",
			"path": "src",
			"group": "build",
			"isBackground": true,
			"problemMatcher": "$tsc-watch"
		}
	]
}
