{
  "name": "prog8-lang",
  "displayName": "Prog8 Language Support",
  "description": "Syntax highlighting and language support for Prog8, a structured programming language for 8-bit 6502/65c02 microprocessors",
  "version": "1.6.14",
  "publisher": "SadLogic",
  "author": "Thraka",
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thraka/prog8-lang"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onDebugResolve:prog8"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "prog8",
    "progb",
    "commander x16",
    "cx16"
  ],
  "icon": "images/prog8-icon.png",
  "contributes": {
    "languages": [
      {
        "id": "prog8",
        "aliases": [
          "Prog8",
          "prog8"
        ],
        "extensions": [
          ".p8"
        ],
        "configuration": "./language-configuration-prog8.json"
      },
      {
        "id": "progb",
        "aliases": [
          "ProgB",
          "progb"
        ],
        "extensions": [
          ".pb"
        ],
        "configuration": "./language-configuration-progb.json"
      }
    ],
    "grammars": [
      {
        "language": "prog8",
        "scopeName": "source.prog8",
        "path": "./syntaxes/prog8.tmLanguage.json"
      },
      {
        "language": "progb",
        "scopeName": "source.progb",
        "path": "./syntaxes/progb.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "prog8",
        "scopes": {
          "namespace": ["entity.name.namespace.prog8"],
          "function": ["entity.name.function.prog8"],
          "variable": ["variable.other.prog8"],
          "variable.readonly": ["variable.other.constant.prog8"],
          "parameter": ["variable.parameter.prog8"],
          "property": ["variable.other.property.prog8"],
          "label": ["entity.name.label.prog8"],
          "struct": ["entity.name.type.struct.prog8"],
          "type": ["entity.name.type.prog8"]
        }
      },
      {
        "language": "progb",
        "scopes": {
          "namespace": ["entity.name.namespace.progb"],
          "function": ["entity.name.function.progb"],
          "variable": ["variable.other.progb"],
          "variable.readonly": ["variable.other.constant.progb"],
          "parameter": ["variable.parameter.progb"],
          "property": ["variable.other.property.progb"],
          "label": ["entity.name.label.progb"],
          "struct": ["entity.name.type.struct.progb"],
          "type": ["entity.name.type.progb"]
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "prog8.project.json",
        "url": "./schemas/prog8.project.schema.json"
      }
    ],
    "configuration": {
      "title": "Prog8",
      "properties": {
        "prog8.completion.showBuiltinFunctions": {
          "type": "boolean",
          "default": true,
          "description": "Show built-in functions (abs, len, peek, poke, etc.) in IntelliSense completions"
        },
        "prog8.completion.showKeywords": {
          "type": "boolean",
          "default": true,
          "description": "Show language keywords (if, for, ubyte, etc.) in IntelliSense completions"
        },
        "progb.keywordCasing": {
          "type": "string",
          "enum": ["upper", "lower", "camel", "disabled"],
          "enumDescriptions": [
            "UPPERCASE - END IF, MODULE, DIM",
            "lowercase - end if, module, dim",
            "Camel Case - End If, Module, Dim",
            "Disabled - no automatic casing"
          ],
          "default": "upper",
          "description": "Automatically format ProgB keywords to the specified casing style when editing"
        },
        "progb.formatCommaSpacing": {
          "type": "boolean",
          "default": true,
          "description": "Automatically add a space after commas in ProgB code (e.g., 'func(a,b,c)' becomes 'func(a, b, c)')"
        },
        "prog8.targetPlatform": {
          "type": "string",
          "enum": ["cx16", "c64", "c128", "pet32", "virtual"],
          "enumDescriptions": [
            "Commander X16",
            "Commodore 64",
            "Commodore 128",
            "Commodore PET 32K",
            "Virtual (testing)"
          ],
          "default": "cx16",
          "description": "Target platform for Prog8 compilation. Affects library completions and hover information."
        },
        "prog8.compiler.path": {
          "type": "string",
          "default": "",
          "description": "Path to prog8c compiler (executable or .jar file)"
        },
        "prog8.compiler.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Path to Java executable (only needed if compiler is a .jar file)"
        },
        "prog8.compiler.assemblerFolder": {
          "type": "string",
          "default": "",
          "description": "Folder containing the 64tass assembler binary (required by compiler)"
        },
        "prog8.emulator.folder": {
          "type": "string",
          "default": "",
          "description": "Folder containing emulators (x16emu, x64sc, x128, xpet)"
        }
      }
    },
    "problemMatchers": [
      {
        "name": "prog8",
        "owner": "prog8",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(ERROR|WARN|INFO)\\s+file:///(\\S+?):(\\d+):(\\d+):\\s+(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    ],
    "commands": [
      {
        "command": "prog8.selectTargetPlatform",
        "title": "Prog8: Select Target Platform"
      },
      {
        "command": "prog8.initProject",
        "title": "Prog8: Initialize Project"
      },
      {
        "command": "prog8.runProject",
        "title": "Prog8: Run Project"
      },
      {
        "command": "prog8.buildProject",
        "title": "Prog8: Build Project"
      }
    ],
    "debuggers": [
      {
        "type": "prog8",
        "label": "Prog8",
        "languages": ["prog8", "progb"],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "projectFile": {
                "type": "string",
                "description": "Path to prog8.project.json (optional, auto-detected from current file)"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "prog8",
            "request": "launch",
            "name": "Run Prog8 Project"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Prog8: Run Project",
            "description": "Compile and run a Prog8 project",
            "body": {
              "type": "prog8",
              "request": "launch",
              "name": "Run Prog8 Project"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}
