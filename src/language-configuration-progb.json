{
  "comments": {
    "lineComment": "'",
    "blockComment": ["/'", "'/"]
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "(?i)\\b(MODULE|SUB|FUNCTION|ASMSUB|IF|FOR|WHILE|DO|REPEAT|SELECT|TYPE|ASM|IR|DEFER)\\b",
      "end": "(?i)\\b(END\\s+(MODULE|SUB|FUNCTION|ASMSUB|IF|SELECT|TYPE|ASM|IR|REPEAT|DEFER)|NEXT|WEND|LOOP)\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "(?i)^\\s*(MODULE|SUB|FUNCTION|ASMSUB|IF|THEN|ELSEIF|ELSE|FOR|WHILE|DO|REPEAT|SELECT|CASE|TYPE|ASM|IR|DEFER)\\b",
    "decreaseIndentPattern": "(?i)^\\s*(END\\s+(MODULE|SUB|FUNCTION|ASMSUB|IF|SELECT|TYPE|ASM|IR|REPEAT|DEFER)|NEXT|WEND|LOOP|ELSEIF|ELSE|CASE)\\b"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}
